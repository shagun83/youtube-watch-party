# Port the HTTP + WebSocket server listens on (Render/Railway set this automatically)
PORT=5000
# Secret used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed browser origins (only needed if the client is hosted separately)
# Leave empty when the server serves the built client itself.
CLIENT_URL=http://localhost:5173
# SQLite file location (mount a persistent disk here in production)
DATABASE_PATH=./data/watchparty.db
# Max users per room
MAX_ROOM_SIZE=100
# Optional: enables the Socket.IO Redis adapter for horizontal scaling
# REDIS_URL=redis://localhost:6379
# bcrypt cost factor
BCRYPT_ROUNDS=10
